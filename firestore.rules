rules_version = '2';

// Lab 3.3 · Security Rules ของ BaanBrew
// หลักคิด: ปิดทุกอย่างเป็นค่าเริ่มต้น แล้วเปิดเฉพาะที่แอปใช้จริง
// - เว็บอ่านได้เมื่อล็อกอินเท่านั้น
// - เว็บเขียนได้อย่างเดียวคือ "สร้างยอดขายใหม่" และข้อมูลต้องหน้าตาเหมือนที่ buildSale() สร้างทุกฟิลด์
// - การนำเข้าข้อมูล (npm run seed) ใช้ firebase-admin ซึ่งข้าม rules ได้ จึงไม่ต้องเปิดสิทธิ์เขียนให้เว็บ
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- ฟังก์ชันช่วย ----------

    // ล็อกอินแล้ว (request.auth เป็น null ถ้ายังไม่ล็อกอิน)
    function signedIn() {
      return request.auth != null;
    }

    // พนักงานร้าน = ล็อกอินแล้ว และบัญชีได้รับ custom claim staff = true
    // "ล็อกอินด้วย Google" อย่างเดียวไม่พอ เพราะบัญชี Google ใดในโลกก็ล็อกอินได้ (ข้อมูลลูกค้าเป็นข้อมูลส่วนบุคคลตาม PDPA)
    // ให้สิทธิ์ด้วย: npm run grant-staff -- อีเมล  (scripts/grant-staff.mjs) แล้วออกจากระบบ-เข้าใหม่ 1 ครั้ง
    // ไม่ใส่รายชื่ออีเมลไว้ในไฟล์นี้ เพราะ repo เป็นสาธารณะ
    function isStaff() {
      return signedIn() && request.auth.token.staff == true;
    }

    // 5 สาขา และ 5 วิธีชำระเงิน — ต้องตรงกับ BRANCHES และ PAYMENTS ใน src/lab3/saleModel.js
    function branches() {
      return ['สยาม', 'สีลม', 'อารีย์', 'บางนา', 'มหาวิทยาลัย'];
    }
    function payments() {
      return ['QR พร้อมเพย์', 'บัตรเครดิต', 'เงินสด', 'LINE MAN', 'Grab'];
    }

    // ฟิลด์ทั้งหมดที่เอกสารยอดขายจากเว็บต้องมี = ฟิลด์ของ buildSale() + created_at
    function saleFields() {
      return ['order_id', 'datetime', 'date', 'hour', 'branch', 'product_id', 'qty', 'unit_price',
              'revenue', 'customer_id', 'payment_method', 'channel', 'source', 'created_by', 'created_at'];
    }

    // ตรวจเอกสารยอดขายใหม่ทีละเงื่อนไข (d = ข้อมูลที่ส่งมา)
    function isValidNewSale(d) {
      // 1) ฟิลด์ครบทุกตัว (hasAll) และไม่มีฟิลด์แปลกปลอม (hasOnly)
      //    กันการแอบเพิ่มฟิลด์ เช่น discount หรือ is_admin
      return d.keys().hasAll(saleFields())
        && d.keys().hasOnly(saleFields())

        // 2) source ต้องเป็น "web" — แยกยอดที่บันทึกจากเว็บออกจากข้อมูลที่ import ("import")
        && d.source == 'web'

        // 3) created_by ต้องเป็น uid ของคนที่ล็อกอินอยู่จริง — ปลอมตัวเป็นผู้ใช้อื่นไม่ได้
        && d.created_by == request.auth.uid

        // 4) created_at ต้องเป็นเวลาของเซิร์ฟเวอร์ (serverTimestamp()) — ใส่เวลาย้อนหลังเองไม่ได้
        && d.created_at == request.time

        // 5) สาขาและวิธีชำระเงินต้องอยู่ในรายการที่กำหนด
        && d.branch in branches()
        && d.payment_method in payments()

        // 6) ช่องทางต้องคำนวณจากวิธีชำระเงินแบบเดียวกับ buildSale():
        //    LINE MAN / Grab = เดลิเวอรี, อย่างอื่น = หน้าร้าน (กันรายงานช่องทางเพี้ยน)
        && d.channel == (d.payment_method in ['LINE MAN', 'Grab'] ? 'เดลิเวอรี' : 'หน้าร้าน')

        // 7) qty เป็นจำนวนเต็ม 1–20 (ตรงกับ MAX_QTY) — กันจำนวนติดลบ ทศนิยม หรือเยอะผิดปกติ
        && d.qty is int && d.qty >= 1 && d.qty <= 20

        // 8) ราคาต่อหน่วยต้องเท่ากับราคาเมนูใน products/{product_id}
        //    ใช้ get() อ่านราคาจริงจากฐานข้อมูล ผู้ใช้ตั้งราคาเองไม่ได้ (เมนูที่ไม่มีอยู่จริงก็ไม่ผ่านด้วย)
        && d.product_id is string
        && exists(/databases/$(database)/documents/products/$(d.product_id))
        && d.unit_price == get(/databases/$(database)/documents/products/$(d.product_id)).data.price

        // 9) ยอดรวมต้องเท่ากับ จำนวน × ราคา พอดี — กันการแก้ revenue ให้สูงหรือต่ำกว่าจริง
        && d.revenue == d.qty * d.unit_price

        // 10) datetime เป็นเวลาไทยรูปแบบ YYYY-MM-DDTHH:MM:SS+07:00 (ปี ค.ศ. 20xx เท่านั้น ไม่รับ พ.ศ.)
        && d.datetime is string
        && d.datetime.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][+]07:00$')

        // 11) date เป็น YYYY-MM-DD และต้องเป็นวันเดียวกับใน datetime
        //     (Dashboard กรองด้วย date ถ้าไม่ตรงกัน ยอดจะไปโผล่ผิดวัน)
        && d.date is string
        && d.date.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && d.date == d.datetime[0:10]

        // 12) hour เป็นจำนวนเต็ม 0–23 และต้องเป็นชั่วโมงเดียวกับใน datetime (กราฟรายชั่วโมงใช้ฟิลด์นี้)
        && d.hour is int && d.hour >= 0 && d.hour <= 23
        && d.hour == int(d.datetime[11:13])

        // 13) customer_id เป็น null (ลูกค้าทั่วไป) หรือ C ตามด้วยเลข 5 หลัก เช่น C01234
        //     ห้ามเป็นสตริงว่าง "" เพราะจะนับเป็นสมาชิกผิด
        && (d.customer_id == null
            || (d.customer_id is string && d.customer_id.matches('^C[0-9]{5}$')))

        // 14) order_id ต้องเป็นข้อความที่ไม่ว่าง
        && d.order_id is string && d.order_id.size() > 0;
    }

    // ---------- เมนู และ สาขา ----------
    // อ่านได้เมื่อล็อกอิน · เขียนไม่ได้เลยจากเว็บ (แก้ผ่าน seed script ที่ใช้ admin เท่านั้น)
    match /products/{productId} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /branches/{branchId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ---------- ผลวิเคราะห์ (Day 4) ----------
    // เอกสารสรุป 5 ชิ้น (meta, daily, rfm, cohort, abc) อ่านได้เมื่อล็อกอิน
    // เขียนได้เฉพาะ scripts/build-analytics.mjs ที่ใช้ firebase-admin (ข้าม rules) จึงปิดการเขียนจากเว็บ
    match /analytics/{docId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ---------- ยอดขาย ----------
    match /sales/{saleId} {
      // อ่านได้เมื่อล็อกอิน
      allow read: if isStaff();

      // สร้างได้เมื่อล็อกอิน และข้อมูลต้องผ่านทุกเงื่อนไขของ isValidNewSale()
      // หมายเหตุ: setDoc ทับเอกสารที่มีอยู่แล้วนับเป็น update จึงถูกปฏิเสธ — เขียนทับยอดเดิมไม่ได้
      allow create: if isStaff() && isValidNewSale(request.resource.data);

      // ยอดขายที่บันทึกแล้วแก้ไขหรือลบไม่ได้ (ถ้าบันทึกผิดให้บันทึกรายการปรับยอดแทน)
      allow update, delete: if false;
    }

    // collection อื่นที่ไม่ได้ระบุไว้ข้างบน: ไม่มี allow ใดตรง จึงถูกปฏิเสธทั้งหมดโดยอัตโนมัติ
  }
}
